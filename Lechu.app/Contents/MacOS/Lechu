#!/bin/bash
set -uo pipefail

# Project folder: where this .app lives (<project>/X.app); LECHU_PROJECT_DIR overrides it,
# and ~/.lechu_project_dir covers a copy of the app moved elsewhere (e.g. /Applications).
HERE="$(cd "$(dirname "$0")/../../.." && pwd)"
if [ -n "${LECHU_PROJECT_DIR:-}" ]; then
    PROJECT_DIR="$LECHU_PROJECT_DIR"
elif [ -x "$HERE/.venv/bin/python3" ]; then
    PROJECT_DIR="$HERE"
elif [ -f "$HOME/.lechu_project_dir" ]; then
    PROJECT_DIR="$(cat "$HOME/.lechu_project_dir")"
else
    PROJECT_DIR="$HERE"
fi
VENV="$PROJECT_DIR/.venv"
LOG="$PROJECT_DIR/data/lechu_launcher.log"

mkdir -p "$PROJECT_DIR/data"
echo "--- $(date) ---" >> "$LOG"

notify_error() {
    osascript -e "display dialog \"$1\" with title \"Lechu\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1
}

# Make sure Ollama is running
if ! curl -s -o /dev/null --max-time 2 http://localhost:11434/api/version; then
    if ! command -v ollama >/dev/null 2>&1; then
        notify_error "No encuentro el comando 'ollama'. Instalalo desde https://ollama.com antes de abrir Lechu."
        exit 1
    fi
    nohup ollama serve >> "$LOG" 2>&1 &
    for _ in $(seq 1 15); do
        curl -s -o /dev/null --max-time 1 http://localhost:11434/api/version && break
        sleep 1
    done
fi

if [ ! -x "$VENV/bin/python3" ]; then
    notify_error "No encuentro el entorno virtual del proyecto en $VENV. Corré el setup de README.md primero."
    exit 1
fi

cd "$PROJECT_DIR" || exit 1
exec "$VENV/bin/python3" app.py >> "$LOG" 2>&1
